; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="game"
run/main_scene="res://ui/splash/splash.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://audio/game_bus_layout.tres"

[autoload]

Events="*res://core/events.gd"
GameManager="*res://core/game_manager.gd"
SceneTransition="*res://core/scene_transition.tscn"
SaveManager="*res://core/save_manager.gd"
Progression="*res://core/progression.gd"
AudioManager="*res://core/audio_manager.gd"
Achievements="*res://core/achievement_manager.gd"
Toast="*res://ui/toast/toast.tscn"
Dialogue="*res://ui/dialogue/dialogue.tscn"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[gui]

theme/custom="res://ui/theme/ui_theme.tres"

